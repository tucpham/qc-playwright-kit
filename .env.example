# Copy to .env for local runs. In CI, set these as secrets. Never commit .env.

# Which environment from project/project.config.ts (local | dev | staging ...)
TEST_ENV=local
# Optional overrides
# BASE_URL=
# API_URL=

# Test accounts per role (demo app values below)
ADMIN_USER=admin
ADMIN_PASS=admin123
USER_USER=user
USER_PASS=user123

# Use installed Google Chrome instead of downloaded Playwright browsers (optional)
# BROWSER_CHANNEL=chrome
