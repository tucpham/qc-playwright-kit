{
  "name": "qc-playwright-kit",
  "version": "1.0.0",
  "description": "Shared Playwright regression starter kit: core kit + project adapter + AI (MCP) workflow",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "demo:app": "node demo-app/server.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:critical": "playwright test --grep @critical",
    "report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "tsc",
    "trace:check": "node scripts/check-traceability.mjs",
    "stabilize": "node scripts/stabilize.mjs",
    "stabilize:changed": "node scripts/stabilize.mjs --changed",
    "tc:import": "node scripts/testcases-csv-to-md.mjs",
    "metrics": "node scripts/metrics.mjs",
    "verify": "npm run typecheck && npm run lint && npm run trace:check",
    "agents:init": "playwright init-agents --loop=claude",
    "guard": "node scripts/guard-test-changes.mjs",
    "metrics:gate": "node scripts/metrics.mjs --gate"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  }
}
